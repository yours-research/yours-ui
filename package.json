{
  "name": "@yours/ui",
  "version": "0.1.0",
  "description": "Tactile Localism React design kit, 48 Aperture icons, top-center hover-grow icon notch, chat components, and Generative UI primitives for Yours Research.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./genui": {
      "types": "./dist/genui/index.d.ts",
      "import": "./dist/genui/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/components.css": "./dist/styles/components.css"
  },
  "files": [
    "dist",
    "src/icons/*.svg",
    "assets/brand",
    "icons.yaml",
    "LICENSE",
    "README.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/generate-icons.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:visual": "node scripts/visual-specimen.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yours-research/yours-ui.git"
  },
  "homepage": "https://yours.sh",
  "keywords": [
    "react",
    "ui",
    "design-system",
    "chrome-extension",
    "side-panel",
    "icons",
    "generative-ui",
    "ai-chat",
    "yours-research"
  ]
}
